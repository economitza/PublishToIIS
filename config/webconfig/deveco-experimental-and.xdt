<?xml version="1.0" encoding="utf-8"?>
<!-- Parche del web.config de deveco-experimental-and: se aplica en cada publicación, sea cual sea la rama.
     {secreto:Nombre} sale del almacén del servidor (Set-RemotePublishSecret), nunca de git. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <appSettings>
    <!-- SI-2763: los menús «Impactos de tarifa» y «Escandallos de hotel» (SI-2729) abren rows ya identificado, con el emisor de pruebas -->
    <add key="RowsTraspasoEmisor" xdt:Transform="Remove" xdt:Locator="Match(key)" />
    <!-- test-and: deveco-rows saca del emisor el país del usuario (con las dos API de test, a cuál ir) -->
    <add key="RowsTraspasoEmisor" value="test-and" xdt:Transform="Insert" />
    <add key="RowsTraspasoSecreto" xdt:Transform="Remove" xdt:Locator="Match(key)" />
    <add key="RowsTraspasoSecreto" value="{secreto:RowsTraspasoSecreto}" xdt:Transform="Insert" />
    <!-- SI-2729: rows de producción no ve el servidor de test; este e-market enlaza con su copia de test, deveco-rows,
         que acepta el mismo secreto (impactos aún no está allí) -->
    <add key="RowsUrl" xdt:Transform="Remove" xdt:Locator="Match(key)" />
    <add key="RowsUrl" value="https://deveco-rows.economitza.com" xdt:Transform="Insert" />
  </appSettings>
</configuration>
